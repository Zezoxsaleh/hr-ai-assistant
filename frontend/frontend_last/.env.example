# --- HERA frontend configuration (frontend/frontend_last) ---
# Copy to .env and adjust for your environment. Vite exposes VITE_* vars to
# the browser at build/dev time; changing them requires a rebuild/restart.

# FastAPI backend / Gemini-gateway VPN base URL (the /api/v1 prefix included).
# Production default: https://soal.help/api/v1 (repo's OpenAI-compatible Gemini
# gateway). For local work against the FastAPI backend set this to
# http://localhost:8000/api/v1 (an unset var falls back to the same default).
VITE_API_BASE_URL=https://soal.help/api/v1

# Development identity defaults. The backend uses header-based identity
# (X-Organization-Id / X-User-Id) - there is NO login/JWT in the MVP. These
# values seed the identity and can be changed at runtime on the Development
# Identity page (/identity); any overrides are persisted in localStorage.
VITE_ORG_ID=
VITE_USER_ID=