POSTGRES_DB=hr_ai_assistant
POSTGRES_USER=hr_ai_assistant
POSTGRES_PASSWORD=change-me

# AI provider used by the composed stack.
# fake -> deterministic matcher, no API key, works offline (demo default)
# soal -> live LLM evaluation via SOAL_API_KEY
AI_PROVIDER=fake
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gemini-3.5-flash

# Published port for the frontend (host side)
FRONTEND_PORT=8080